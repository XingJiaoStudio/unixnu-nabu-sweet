+static unsigned panel_sb_at, panel_fatal_at, panel_usb_at;
 static unsigned panel_execs, panel_crashes, panel_sbexec, panel_sbcrash;
 static boolean_t panel_thread_running;
 
@@ -921,14 +920,27 @@
 static void
 panel_take(const char *line)
 {
-	if (panel_has(line, "SpringBoard")) {
+	/*
+	 * The compact SWEET CS lines carry the whole diagnosis (file, offset,
