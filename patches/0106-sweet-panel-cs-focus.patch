 		if (panel_has(line, "CRASH ")) {
 			panel_sbcrash++;
 		}
+		/* Keep the frame summary, not the sixteen register rows. */
+		if (panel_has(line, "exec ") || panel_has(line, " reason ") ||
+		    panel_has(line, " bt ") || panel_has(line, " slide ")) {
+			panel_keep(panel_sb, &panel_sb_at, PANEL_SB, line);
+		}
 		return;
 	}
