  * The filter is deliberately narrow. Boot reaches SpringBoard but it dies, and
  * a plain tail is drowned by the xpcproxy respawn loop, so each interesting
  * class of line gets its own ring that other daemons cannot push out:
- * every SpringBoard line, every assertion/dyld/AMFI denial from any process,
- * the last USB control requests, and the last AMFI entitlement tallies.
+ * every SpringBoard line plus the compact SWEET CS page-rejection lines from
+ * any process, every assertion/dyld failure, and the last USB control
+ * requests.
  *
  * Reading is incremental from an absolute cursor, so ring wraparound cannot
- * lose a line. Nothing is allocated: five small static line rings.
+ * lose a line. Nothing is allocated: four small static line rings.
  */
 #define PANEL_LINE      68              /* the console font wraps past ~70 */
-#define PANEL_SB        18
-#define PANEL_FATAL     6
+#define PANEL_SB        28
+#define PANEL_FATAL     4
 #define PANEL_USB       3
-#define PANEL_AMFI      3
 #define PANEL_CHUNK     512
 
 static char panel_sb[PANEL_SB][PANEL_LINE];
 static char panel_fatal[PANEL_FATAL][PANEL_LINE];
 static char panel_usb[PANEL_USB][PANEL_LINE];
-static char panel_amfi[PANEL_AMFI][PANEL_LINE];
 static char panel_line[PANEL_LINE];
