+ * Live console log as a plain byte stream: every 100 ms the new bytes of the
+ * console ring (bsd/dev/sweet_ufs.c) are pushed out on bulk IN, where the
+ * host reads them from its serial port.  Starts with the last 64 KiB so the
+ * boot is included.  Nothing here may print (it would feed itself).
  * Boot-arg sweetusblog=0 disables it.
  */
 extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
 extern uint64_t sweet_log_position(void);
 
+static bool
+ud_tx_free(void)
+{
+	bool free_now;
+
+	lck_mtx_lock(ud.lock);
+	free_now = ud.configured && !ud.tx_busy;
+	lck_mtx_unlock(ud.lock);
+	return free_now;
+}
+
+static void
+ud_raw_send(const char *buf, uint32_t len)
+{
+	lck_mtx_lock(ud.lock);
+	if (ud.configured && !ud.tx_busy) {
+		if (len > UD_FRAME_MAX) {
+			len = UD_FRAME_MAX;
+		}
+		memcpy((void *)(ud.dma + UD_TX), buf, len);
+		/* A transfer of a multiple of 512 bytes would need a zero-length
+		 * packet to end it; one newline does the same for a text stream. */
+		if ((len % 512) == 0) {
+			((uint8_t *)(ud.dma + UD_TX))[len++] = '\n';
+		}
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, len, TRBCTL_NORMAL);
+	}
+	lck_mtx_unlock(ud.lock);
+}
