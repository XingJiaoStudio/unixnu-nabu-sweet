--- a/bsd/kern/kern_cs.c
+++ b/bsd/kern/kern_cs.c
@@ -85,6 +85,12 @@
 int cs_force_kill = 0;
 int cs_force_hard = 0;
 int cs_debug = 0;
+/*
+ * sweet: sweetcs_allow=1 makes page validation advisory. A signed binary whose
+ * pages no longer verify is still allowed to run, so it can be observed
+ * instead of dying in a respawn loop; without the boot-arg nothing changes.
+ */
+int sweet_cs_allow = 0;
 // If set, AMFI will error out early on unsigned code, before evaluation the normal policy.
 int cs_debug_fail_on_unsigned_code = 0;
 // If the previous mode is enabled, we count the resulting failures here.
@@ -180,6 +186,8 @@
 	    sizeof(cs_relax_platform_task_ports));
 
 	PE_parse_boot_argn("cs_debug", &cs_debug, sizeof(cs_debug));
+	PE_parse_boot_argn("sweetcs_allow", &sweet_cs_allow,
+	    sizeof(sweet_cs_allow));
 
 #if !CONFIG_ENFORCE_LIBRARY_VALIDATION
 	PE_parse_boot_argn("cs_library_val_enable", &cs_library_val_enable,
@@ -263,6 +271,10 @@
 
 	flags = proc_getcsflags(p);
 
+	if (sweet_cs_allow) {
+		flags &= ~(CS_KILL | CS_HARD);
+	}
+
 	/* XXX for testing */
 	if (cs_force_kill) {
 		flags |= CS_KILL;
