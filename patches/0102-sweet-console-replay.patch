+extern int sweet_console_muted;         /* osfmk/console/serial_console.c */
+
+/*
+ * SWEETDBG: iOS userland respawns a broken daemon in a tight loop, and the
+ * console is far too busy to read on a phone screen. So: watch the ring for
+ * the FIRST crash of this boot, replay that block (with the lines just before
+ * it), print the current tail, then freeze the text console. One photograph
+ * then shows what actually went wrong instead of the steady-state loop.
+ *
+ * Positions are absolute (sweet_log_total never rewinds), so the scan state
+ * survives ring wraparound and no boot marker is needed.
+ */
+static uint64_t
+ud_ring_scan(uint64_t *pos, const char *needle)
+{
+	uint32_t nl = 0;
+	char chunk[1024];
+	uint64_t total = sweet_log_position();
+
+	while (needle[nl] != 0) {
+		nl++;
+	}
+	while (*pos < total) {
+		uint64_t want = total - *pos;
+		if (want > sizeof(chunk)) {
+			want = sizeof(chunk);
+		}
+		uint32_t n = sweet_log_copy(pos, chunk, (uint32_t)want);
+		if (n == 0) {
+			break;
+		}
+		for (uint32_t i = 0; i + nl <= n; i++) {
+			uint32_t k = 0;
+			while (k < nl && chunk[i + k] == needle[k]) {
+				k++;
+			}
+			if (k == nl) {
+				return *pos - n + i;
+			}
+		}
+		if (*pos >= total) {
+			break;
+		}
+		if (*pos > nl - 1) {
+			*pos -= nl - 1;         /* catch a match across the boundary */
+		} else {
+			*pos = 0;
+		}
+	}
+	return 0;
+}
+
+static void
+ud_ring_print(uint64_t at, uint32_t before, uint32_t bytes)
+{
+	char buf[1600];
+	uint64_t pos = at > before ? at - before : 0;
+	uint32_t n = 0;
+
+	while (n < bytes && n < sizeof(buf) - 1) {
+		uint32_t w = (uint32_t)MIN((uint64_t)(sizeof(buf) - 1 - n),
+		    (uint64_t)(bytes - n));
+		uint32_t got = sweet_log_copy(&pos, buf + n, w);
+		if (got == 0) {
+			break;
+		}
+		n += got;
+	}
+	buf[n] = 0;
+	printf("%s\n", buf);
+}
+
+static void
+ud_dbg_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t scan = sweet_log_position();   /* first byte of this boot */
+	uint64_t crash = 0;
+
+	for (int i = 0; i < 3000 && crash == 0; i++) {   /* give up after 10 min */
+		ud_sleep_ms(200);
+		crash = ud_ring_scan(&scan, "CRASH ");
+	}
+	if (crash != 0) {
+		ud_sleep_ms(2500);              /* let the rest of the block land */
+	}
+	printf("\n\n=== SWEETDBG log=%llu first-crash=%llu ===\n",
+	    sweet_log_position(), crash);
+	if (crash != 0) {
+		ud_ring_print(crash, 520, 1500);
+	} else {
+		printf("(no CRASH line in the ring)\n");
+	}
+	printf("--- tail ---\n");
+	ud_ring_print(sweet_log_position(), 760, 760);
+	printf("=== SWEETDBG end ===\n");
+	sweet_console_muted = 1;                /* keep this on the panel */
+}
